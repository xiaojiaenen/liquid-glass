{
  "name": "@xiaojiaenen/liquid-glass",
  "version": "0.1.0",
  "type": "module",
  "description": "Liquid Glass UI components — Apple WWDC25-inspired glassmorphism for React",
  "license": "MIT",
  "keywords": [
    "react",
    "glassmorphism",
    "liquid-glass",
    "apple",
    "ui-components",
    "backdrop-filter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaojiaenen/liquid-glass"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs"
    },
    "./styles": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "prism-react-renderer": "^2.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prism-react-renderer": "^2.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  }
}
